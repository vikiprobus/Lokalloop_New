# ==============================================================================
# LokalLoop Enterprise Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this template to .env: `cp .env.example .env` (or `copy .env.example .env` on Windows).
# 2. Never commit .env to version control (.gitignore strictly ignores it).
# 3. For production, generate a cryptographically strong secret with:
#    python -c "import secrets; print(secrets.token_urlsafe(64))"
# ==============================================================================

# Core Django Settings
DJANGO_SECRET_KEY=django-insecure-lokalloop-dev-fallback-key-2026-replace-for-prod
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Configurable Built-in Admin URL (masks default /admin/ from automated vulnerability crawlers)
# Example: secure-staff-portal/ -> http://yourdomain.com/secure-staff-portal/
DJANGO_ADMIN_URL=portal-admin/

# Database Configuration (SQLite default for local development, PostgreSQL ready for production)
DATABASE_URL=sqlite:///db.sqlite3
# DB_NAME=lokalloop_db
# DB_USER=lokalloop_admin
# DB_PASSWORD=your_strong_db_password
# DB_HOST=127.0.0.1
# DB_PORT=5432

# Default Regional Localization
DEFAULT_CITY=Pune
DEFAULT_STATE=Maharashtra
DEFAULT_CURRENCY=INR

# Payment Gateway (Razorpay India Integration)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_placeholder

# Google Maps & Geocoding API
GOOGLE_MAPS_API_KEY=AIzaSyPlaceholderKeyForGoogleMaps-DevOnly

# Cloud Storage (Amazon Web Services S3 for Media & Bill Uploads)
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_STORAGE_BUCKET_NAME=lokalloop-secure-media-bucket
AWS_S3_REGION_NAME=ap-south-1

# Firebase Push Notifications & Cloud Messaging
FIREBASE_CREDENTIALS_PATH=config/credentials/firebase-service-account.json
FIREBASE_API_KEY=AIzaSyPlaceholderFirebaseApiKey

# Transactional SMS Gateway / OTP Service (DLT Registered)
SMS_GATEWAY_API_KEY=sms_gateway_test_token_12345
SMS_GATEWAY_SENDER_ID=LOKALP
SMS_GATEWAY_PROVIDER=dummy

# Production SSL & Cookie Security (set to True when deployed behind HTTPS)
